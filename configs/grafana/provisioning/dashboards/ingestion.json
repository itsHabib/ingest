        {
          "expr": "histogram_quantile(0.99, sum(rate(ingest_gateway_request_duration_seconds_bucket[1m])) by (le, tenant))",
          "legendFormat": "p99 {{tenant}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ingest_gateway_request_duration_seconds_bucket[1m])) by (le, tenant))",
